<resources>

    <!-- Base application theme. -->
    <style name="AppTheme.Impl" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="toolbarStyle">@style/Widget.AppTheme.Toolbar</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Impl" />

    <style name="Widget.AppTheme.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorPrimary</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="titleTextColor">@color/colorOnPrimary</item>
        <item name="subtitleTextColor">@color/colorOnPrimary</item>
        <item name="titleTextAppearance">@style/TextAppearance.AppTheme.ToolbarTitle</item>
        <item name="android:theme">@style/ThemeOverlay.AppTheme.ActionBar</item>
        <item name="popupTheme">@style/ThemeOverlay.AppTheme.ToolbarPopup</item>
    </style>

    <style name="ThemeOverlay.AppTheme.ToolbarPopup" parent="ThemeOverlay.Material3.Light">
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    </style>

    <style name="ThemeOverlay.AppTheme.ActionBar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/colorOnPrimary</item>
        <item name="android:textColorPrimary">@color/colorOnPrimary</item>
    </style>

    <style name="TextAppearance.AppTheme.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <!-- Compact checkboxes for horizontal serving rows (M3 defaults add 48dp touch targets). -->
    <style name="ThemeOverlay.ServingCheckBox" parent="">
        <item name="checkboxStyle">@style/Widget.ServingCheckBox</item>
    </style>

    <style name="Widget.ServingCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:background">@null</item>
    </style>

    <style name="Widget.CardContent" parent="android:Widget">
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <style name="HistoryIcon">
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="PrimaryText">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
    </style>

    <style name="SecondaryText">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyMedium</item>
    </style>

    <style name="TextAppearance.AppTheme.CalendarDate" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/calendar_date_text</item>
    </style>

    <style name="TextAppearance.AppTheme.CalendarWeekDay" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.AppTheme.CalendarHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TimeRangeSelector">
        <item name="android:gravity">center</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="TimeRangeSelector.PreviousButton">
        <item name="android:text">{fa-chevron-left 14dp @color/gray_dark}</item>
    </style>

    <style name="TimeRangeSelector.NextButton">
        <item name="android:text">{fa-chevron-right 14dp @color/gray_dark}</item>
    </style>

    <style name="TimeRangeSelector.Selected">
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

</resources>
